{
  "about": "How the narrator says words that text-to-speech gets wrong. voice.mjs swaps each listed word for its alias before sending the line to ElevenLabs, so captions keep the written form and the voice reads the spoken one. Aliases work on every ElevenLabs model, unlike phoneme tags. `npm run voice:lint` fails on any word in the narration that looks risky (capitals, symbols, digits, file names) and has no rule here. `npm run voice:dict` also exports these rules as a PLS lexicon (pronunciations.pls) and uploads it as an ElevenLabs pronunciation dictionary. Each rule: `say` is what the voice reads; `why` records the choice. Matching ignores surrounding punctuation; `case: true` makes it case-sensitive.",
  "rules": [
    { "word": "variantly", "say": "variant-lee", "why": "VAIR-ee-ent-lee: 'variant' plus '-ly', the owner's pronunciation." },
    { "word": "Variantly", "say": "Variant-lee", "case": true, "why": "Same, capitalised at a sentence start." },
    { "word": "variantly.style", "say": "variant-lee dot style", "why": "The domain, read out." },
    { "word": "impeccable.style", "say": "impeccable dot style", "why": "The domain, read out." },
    { "word": "Impeccable", "say": "Impeccable", "case": true, "why": "Plain English word; listed so the lint knows it is checked." },
    { "word": "npx", "say": "N P X", "why": "Spelled out, as developers say it." },
    { "word": "npm", "say": "N P M", "why": "Spelled out." },
    { "word": "pnpm", "say": "P N P M", "why": "Spelled out." },
    { "word": "CLI", "say": "C L I", "case": true, "why": "Spelled out." },
    { "word": "UI", "say": "U I", "case": true, "why": "Spelled out." },
    { "word": "UX", "say": "U X", "case": true, "why": "Spelled out." },
    { "word": "UI/UX", "say": "U I, U X", "case": true, "why": "Spelled out, with a pause." },
    { "word": "AI", "say": "A I", "case": true, "why": "Spelled out." },
    { "word": "API", "say": "A P I", "case": true, "why": "Spelled out." },
    { "word": "SEO", "say": "S E O", "case": true, "why": "Spelled out." },
    { "word": "LCP", "say": "L C P", "case": true, "why": "Core Web Vitals metric, spelled out." },
    { "word": "INP", "say": "I N P", "case": true, "why": "Core Web Vitals metric, spelled out." },
    { "word": "CLS", "say": "C L S", "case": true, "why": "Core Web Vitals metric, spelled out." },
    { "word": "WCAG", "say": "wuh-kag", "case": true, "why": "Said 'wuh-cag' in the accessibility community." },
    { "word": "AA", "say": "double A", "case": true, "why": "WCAG conformance level." },
    { "word": "JSON", "say": "jay-son", "case": true, "why": "Common usage." },
    { "word": "GIF", "say": "gif", "case": true, "why": "Hard g, the common usage." },
    { "word": "sRGB", "say": "S R G B", "case": true, "why": "Spelled out." },
    { "word": "axe-core", "say": "axe core", "why": "The accessibility engine's name, without the hyphen." },
    { "word": "axe", "say": "axe", "why": "Plain word; listed for the lint." },
    { "word": "Lighthouse", "say": "Lighthouse", "case": true, "why": "Plain word; listed for the lint." },
    { "word": "git", "say": "git", "why": "Hard g." },
    { "word": "GitHub", "say": "Git Hub", "case": true, "why": "Two words, so the 'h' is not swallowed." },
    { "word": "worktree", "say": "work tree", "why": "Two words." },
    { "word": "worktrees", "say": "work trees", "why": "Two words." },
    { "word": "localhost", "say": "local host", "why": "Two words." },
    { "word": "OpenRouter", "say": "Open Router", "case": true, "why": "Two words; 'router' as in network, the US reading." },
    { "word": "Codex", "say": "Codex", "case": true, "why": "Listed for the lint." },
    { "word": "Gemini", "say": "Jem-in-eye", "case": true, "why": "Google's product is said JEM-in-eye." },
    { "word": "Copilot", "say": "Co-pilot", "case": true, "why": "Two parts." },
    { "word": "Cursor", "say": "Cursor", "case": true, "why": "Listed for the lint." },
    { "word": "ElevenLabs", "say": "Eleven Labs", "case": true, "why": "Two words." },
    { "word": "Tallyboard", "say": "Tally board", "case": true, "why": "The fictional demo site; two words." },
    { "word": "&", "say": "and", "why": "As in 'Oak & Iron'." },
    { "word": "DESIGN.md", "say": "design dot M D", "case": true, "why": "File name, read out." },
    { "word": "PRODUCT.md", "say": "product dot M D", "case": true, "why": "File name, read out." },
    { "word": "SKILLS.md", "say": "skills dot M D", "case": true, "why": "File name, read out." },
    { "word": "iPhone", "say": "eye-phone", "case": true, "why": "Apple product, said eye-phone." },
    { "word": "FAQ", "say": "F A Q", "case": true, "why": "Spelled out." },
    { "word": "README", "say": "read me", "case": true, "why": "Common usage." },
    { "word": "Node.js", "say": "Node J S", "case": true, "why": "Common usage." },
    { "word": "macOS", "say": "mac O S", "case": true, "why": "Common usage." },
    { "word": "2D", "say": "two D", "case": true, "why": "Read out." },
    { "word": "3D", "say": "three D", "case": true, "why": "Read out." },
    { "word": "16:9", "say": "sixteen by nine", "why": "Aspect ratio." },
    { "word": "9:16", "say": "nine by sixteen", "why": "Aspect ratio." },
    { "word": "fps", "say": "frames per second", "why": "Unit, read in full." },
    { "word": "kurbits", "say": "KOOR-bits", "why": "Swedish Dalarna folk painting." },
    { "word": "Dalarna", "say": "DAH-lar-na", "case": true, "why": "Swedish province." },
    { "word": "Otomí", "say": "oh-toh-MEE", "case": true, "why": "Mexican people and embroidery tradition." },
    { "word": "Tenango", "say": "teh-NAHN-go", "case": true, "why": "Tenango de Doria embroidery." },
    { "word": "Didone", "say": "dee-DOH-nay", "case": true, "why": "Type classification." },
    { "word": "Bodoni", "say": "boh-DOH-nee", "case": true, "why": "Typeface." },
    { "word": "2026", "say": "twenty twenty-six", "why": "A year, as in 'Winter 2026': said as a year, not 'two thousand twenty-six'." },
    { "word": "Bauhaus", "say": "BOW-house", "case": true, "why": "German school of design; a variantly.style concept." },
    { "word": "Riso", "say": "REE-zoh", "case": true, "why": "Short for Risograph; the 'Riso Poster' concept." },
    { "word": "TVA", "say": "T V A", "case": true, "why": "The 'TVA Terminal' concept, spelled out." },
    { "word": "Noir", "say": "nwahr", "case": true, "why": "French, as in film noir; the 'Noir Velvet' concept." },
    { "word": "noir", "say": "nwahr", "why": "Lowercase noir on its own (film-noir is one token and reads fine)." },
    { "word": "Oak", "say": "Oak", "case": true, "why": "The demo shop 'Oak & Iron'; listed for the lint." },
    { "word": "Claude", "say": "Claude", "case": true, "why": "Listed for the lint." },
    { "word": "Next.js", "say": "Next J S", "case": true, "why": "The framework, as its users say it." },
    { "word": "HTML", "say": "H T M L", "case": true, "why": "Spelled out." },
    { "word": "Django", "say": "Jango", "case": true, "why": "The D is silent." },
    { "word": "--blind", "say": "dash dash blind", "why": "The CLI flag, read out." },
    { "word": "Joaquin", "say": "Wah-keen", "case": true, "why": "The presenter's name." }
  ],
  "patterns": [
    { "match": "^V(0?)(\\d{1,2})$", "say": "V {n2}", "why": "Variant labels: V01 is 'V one', V10 is 'V ten'." },
    { "match": "^€(\\d[\\d,]*)$", "say": "{n1} euros", "why": "Currency in words: €3,490 is 'three thousand four hundred ninety euros'." },
    { "match": "^\\$(\\d[\\d,]*)$", "say": "{n1} dollars", "why": "Currency in words." },
    { "match": "^(\\d[\\d,]*)$", "say": "{n1}", "why": "Plain numbers in words." },
    { "match": "^(\\d+)%$", "say": "{n1} percent", "why": "Percentages in words." },
    { "match": "^(\\d+)×$", "say": "{n1} times", "why": "Speed-ups: 40× is 'forty times'." },
    { "match": "^(\\d+(?:\\.\\d+)?)(MB|KB)$", "say": "{n1} {unit}", "why": "Sizes: 1.5MB is 'one point five megabytes'." },
    { "match": "^(\\d+)ms$", "say": "{n1} milliseconds", "why": "Durations in words." }
  ]
}

  "agent": "claude",
  "keep": 2,
  "scenes": [
    {
      "id": "cold",
      "montage": true,
      "hold": 8000,
      "step": "Variantly",
      "kinetic": {
        "text": "Four redesigns. Keep one. Your whole site follows.",
        "sub": "npx variantly",
        "from": 4.2
      },
      "text": "",
      "actions": []
    },
    {
      "id": "hi",
      "chapter": {
        "n": 1,
        "title": "Hi"
      },
      "step": "Hi",
      "lower": {
        "name": "Joaquin",
        "role": "Variantly"
      },
      "text": "Hi, I'm Joaquin from Variantly. This is Tallyboard. It works. It just looks like every other template, and redesigning it means picking one direction and hoping it was right. With Variantly, your own coding agent redesigns your site several times over, each in a different direction, and every redesign runs as your real site. You keep the one you like.",
      "actions": [
        {
          "goto": "{{site}}"
        },
        {
          "wait": 3000
        },
        {
          "scroll": 900,
          "ms": 3200
        },
        {
          "wait": 2500
        },
        {
          "scroll": 2000,
          "ms": 3000
        },
        {
          "wait": 2000
        },
        {
          "scroll": 0,
          "ms": 2500
        }
      ]
    },
    {
      "id": "promise",
      "step": "Hi",
      "hold": 2800,
      "kinetic": {
        "text": "Nothing changes until you keep one."
      },
      "text": "",
      "actions": [
        {
          "wait": 300
        }
      ]
    },
    {
      "id": "need",
      "chapter": {
        "n": 2,
        "title": "What you need"
      },
      "step": "What you need",
      "terminal": {
        "lines": [
          "$ node -v",
          "v22.18.0",
          "# Claude Code · Codex · Copilot · Gemini · Cursor",
          "# or any model via OpenRouter",
          "$ npx variantly"
        ]
      },
      "lower": {
        "name": "Designs by Impeccable",
        "role": "impeccable.style",
        "from": 16
      },
      "text": "You need Node, and a coding agent you already use: Claude Code, Codex, Copilot, Gemini or Cursor. No subscription? Point Claude Code or Codex at OpenRouter. In your project, run npx variantly. It opens a wizard in your browser. The design work is done by Impeccable, an open-source design skill for coding agents. If your agent doesn't have it yet, Variantly installs it in one click.",
      "actions": [
        {
          "wait": 7000
        },
        {
          "goto": "{{app}}"
        },
        {
          "waitFor": "#wiz-title"
        },
        {
          "wait": 1500
        },
        {
          "realOnly": true,
          "click": "role=button[name=\"Install Impeccable\"]",
          "zoom": true,
          "optional": true
        },
        {
          "realOnly": true,
          "waitFor": "text=/Claude Code ready/",
          "timeoutMs": 240000,
          "optional": true
        }
      ]
    },
    {
      "id": "setup",
      "chapter": {
        "n": 3,
        "title": "Setup"
      },
      "step": "Setup",
      "text": "Setup finds your app and how to run it, checks your agent, and flags anything in the way. Each variant runs your dev command on its own port, and the agent may only edit files, in its own copy of your project.",
      "actions": [
        {
          "spotlight": "text=/app found/",
          "ms": 1700,
          "point": true
        },
        {
          "spotlight": "text=/ ready/",
          "ms": 1400,
          "point": true
        },
        {
          "click": "text=Use a different app or agent"
        },
        {
          "spotlight": "text=Dev command",
          "ms": 1600,
          "pad": 60
        },
        {
          "spotlight": "text=Permissions",
          "ms": 1600,
          "pad": 40,
          "optional": true
        },
        {
          "click": "text=Use a different app or agent"
        },
        {
          "click": "role=button[name=/^Continue to variants$/]",
          "zoom": true
        }
      ]
    },
    {
      "id": "make",
      "chapter": {
        "n": 4,
        "title": "What to make"
      },
      "step": "What to make",
      "text": "Pick two, four or six variants. We'll take four, of the home page. That's fastest, and when you keep one, the rest of the site follows. Extras are optional Impeccable passes: sharper copy, motion, delight, a phone pass, or hardening for accessibility. Redesign gives every variant its own visual world; Refine keeps your look and improves it. Leave a direction blank and Impeccable picks one, or type your own.",
      "actions": [
        {
          "click": "role=radio[name=\"4\"]",
          "zoom": true
        },
        {
          "wait": 600
        },
        {
          "spotlight": "text=Which pages?",
          "ms": 1400,
          "pad": 40
        },
        {
          "hover": "role=button[name=/^All \\d+ pages$/]",
          "optional": true
        },
        {
          "spotlight": "text=/restyles the rest of the site/",
          "ms": 2600,
          "pad": 30,
          "point": true
        },
        {
          "spotlight": "label.pick:has-text(\"Rewrite the copy\")",
          "ms": 1300,
          "callout": "Sharper headlines, buttons and labels. Facts, prices and names stay.",
          "point": true
        },
        {
          "spotlight": "label.pick:has-text(\"Add motion\")",
          "ms": 1300,
          "callout": "Purposeful transitions and entrances, with reduced motion respected.",
          "point": true
        },
        {
          "spotlight": "label.pick:has-text(\"Add delight\")",
          "ms": 1300,
          "callout": "Small moments of personality: empty states, hovers, details.",
          "point": true
        },
        {
          "spotlight": "label.pick:has-text(\"Polish for phones\")",
          "ms": 1300,
          "callout": "Check every chosen page at phone width and fix what breaks.",
          "point": true
        },
        {
          "spotlight": "label.pick:has-text(\"Harden\")",
          "ms": 1300,
          "callout": "Accessibility, focus states, long text and error states.",
          "point": true
        },
        {
          "click": "text=More settings"
        },
        {
          "spotlight": "text=Approach",
          "ms": 2600,
          "pad": 50
        },
        {
          "spotlight": "text=/Your own directions/",
          "ms": 2600,
          "pad": 60
        },
        {
          "click": "text=More settings"
        },
        {
          "click": "role=button[name=\"Continue to your site\"]"
        }
      ]
    },
    {
      "id": "brief",
      "chapter": {
        "n": 5,
        "title": "Brief and go"
      },
      "step": "Brief and go",
      "text": "A few words about your site, and what must stay. Here: the prices, the sign-up button and the FAQ. Agents change presentation, never behaviour. The review shows exactly what runs, and how many sessions it uses on your own account. Make four variants.",
      "actions": [
        {
          "fill": "role=textbox[name=/Who is it for/]",
          "text": "Small agencies that bill by the hour.",
          "delay": 12
        },
        {
          "fill": "role=textbox[name=/What does it offer/]",
          "text": "Timers, timesheets and invoices.",
          "delay": 12
        },
        {
          "fill": "role=textbox[name=/What must stay/]",
          "text": "Prices, the sign-up button, the FAQ.",
          "delay": 12
        },
        {
          "spotlight": "role=textbox[name=/What must stay/]",
          "ms": 2400,
          "pad": 30
        },
        {
          "click": "role=button[name=\"Continue to review\"]"
        },
        {
          "wait": 600
        },
        {
          "spotlight": "text=/Uses \\d+ sessions|Nothing is spent/",
          "ms": 3200,
          "pad": 20
        },
        {
          "click": "role=button[name=/^Make \\d+ variants?$/]",
          "zoom": true,
          "sound": "whoosh"
        }
      ]

        "capture": "fail",
        "per": 0.6,
        "untilEnd": true,
        "title": "~/my-site",
        "prompt": "~/my-site $",
        "lines": [
          "$ npx variantly doctor",
          "✓ node 22.18.0",
          "✓ git version 2.47.0",
          "✗ repository ~/my-site (no commits yet)"

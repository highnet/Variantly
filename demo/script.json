        "capture": "stacks",
        "per": 0.5,
        "from": 0.3,
        "sequence": [
          {
            "title": "~/my-next-app",
            "prompt": "~/my-next-app $",
            "lines": [
              "$ npx variantly doctor",
              "  Next.js  .  →  npx next dev --port {port}"
            ]
          },
          {
            "title": "~/my-django-site",
            "prompt": "~/my-django-site $",
            "lines": [
              "$ npx variantly doctor",
              "  Django  .  →  python manage.py runserver 127.0.0.1:{port}"

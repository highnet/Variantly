        "n": 2,
        "title": "What you need"
      },
      "step": "What you need",
      "terminal": {
        "lines": [
          "$ node -v",
          "v22.18.0",
          "# Claude Code · Codex · Copilot · Gemini · Cursor",
          "# or any model via OpenRouter",
          "$ npx variantly"
        ]
      },
      "lower": {
        "name": "Designs by Impeccable",
        "role": "impeccable.style",
        "from": 15
      },
      "text": "You need two things: Node, and a coding agent you already use. In your project folder, run npx variantly, and a wizard opens in your browser. The design work is done by Impeccable, an open-source design skill. One catch: it has to be the command-line agent, not a browser builder like Lovable or Bolt.",
      "actions": [
        {
          "wait": 7000
        },
        {
          "goto": "{{app}}"
        },
        {
          "waitFor": "#wiz-title"

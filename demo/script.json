    {
      "id": "worktrees",
      "chapter": {
        "n": 6,
        "title": "The run"
      },
      "step": "The run",
      "diagram": "worktrees",
      "text": "Each variant gets its own git worktree, outside your project, and its own dev server. Your checkout isn't touched.",
      "actions": [
        {
          "waitFor": "body[data-view=\"board\"]"
        },
        {
          "wait": 500
        }
      ]
    },
    {
      "id": "agent",
      "step": "The run",
      "text": "The board shows every variant live. Here's one agent at work. It reads your site, lets Impeccable choose a direction, and builds it. Then it checks its variant in a real browser, at desktop and phone width, and fixes what it sees. A second pass critiques and audits it, without changing the direction.",
      "actions": [
        {
          "spotlight": "role=columnheader[name=\"Direction\"]",
          "ms": 1500,
          "pad": 30
        },
        {
          "spotlight": "role=columnheader[name=\"Status\"]",
          "ms": 1200,
          "pad": 30
        },
        {
          "spotlight": "role=columnheader[name=\"Usage\"]",
          "ms": 1500,
          "pad": 30
        },
        {
          "click": "role=button[name=\"Show V01 output\"]"
        },
        {
          "wait": 9000
        }
      ]
    },

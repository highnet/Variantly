// The 60 s cut's music (cuts.mjs renders it with music.mjs). Strudel, as in the
// REPL at strudel.cc: paste it there to hear it. D minor, 96 bpm, a little
// brighter than the 90 s cut. One cycle is a bar: 26 bars ≈ 65 s.
setcpm(96 / 4)

const chords = "<[d3,f3,a3,c4] [bb2,d3,f3,a3] [f3,a3,c4,e4] [c3,e3,g3,bb3]>"
const pad = note(chords).s("sawtooth").lpf(sine.range(800, 1600).slow(8)).attack(0.4).release(1.4).gain(0.12).room(0.5).size(0.7)
const bass = note("<d2 bb1 f2 c2>").s("triangle").struct("x ~ x ~ ~ x ~ x").lpf(400).decay(0.4).sustain(0.3).gain(0.42)
const arp = n("<[0 4 7 9 7 4 9 11] [5 9 12 14 12 9 14 16] [2 6 9 11 9 6 11 13] [-1 3 6 8 6 3 8 10]>")
  .scale("D4:minor").s("square").decay(0.12).sustain(0).lpf(2200).gain(0.09).delay(0.2).delaytime(0.3125).delayfeedback(0.25).room(0.3)
const hat = s("white*8").decay(0.03).sustain(0).hpf(7500).gain("0.05 0.025 0.04 0.025").pan(0.6)
const pulse = note("d1*4").s("sine").decay(0.16).sustain(0).lpf(140).gain(0.32)

arrange(
  [2, pad],
  [2, stack(pad, bass, arp.degradeBy(0.4))],
  [18, stack(pad, bass, arp, hat, pulse)],
  [4, stack(pad, arp.degradeBy(0.5))],
)

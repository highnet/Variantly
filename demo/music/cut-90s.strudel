// The 90 s cut's music (cuts.mjs renders it with music.mjs). Strudel, as in the
// REPL at strudel.cc: paste it there to hear it. D minor, 92 bpm, the same
// chords as the full film's bed. One cycle is a bar: 36 bars ≈ 94 s.
setcpm(92 / 4)

const chords = "<[d3,f3,a3,c4] [bb2,d3,f3,a3] [f3,a3,c4,e4] [c3,e3,g3,bb3]>/2"
const pad = note(chords).s("sawtooth").lpf(sine.range(700, 1400).slow(16)).attack(0.6).release(1.8).gain(0.13).room(0.5).size(0.8)
const bass = note("<d2 bb1 f2 c2>/2").s("triangle").struct("x ~ ~ x ~ ~ x ~").lpf(380).decay(0.5).sustain(0.3).gain(0.42)
const arp = n("<[0 2 4 7 4 2 7 9] [5 7 9 12 9 7 12 14] [2 4 6 9 6 4 9 11] [-1 1 3 6 3 1 6 8]>/2")
  .scale("D4:minor").s("triangle").decay(0.18).sustain(0).lpf(2600).gain(0.16).delay(0.25).delaytime(0.375).delayfeedback(0.3).room(0.3)
const hat = s("white*8").decay(0.03).sustain(0).hpf(7000).gain("0.05 0.025 0.04 0.025").pan(0.6)
const pulse = note("d1*4").s("sine").decay(0.16).sustain(0).lpf(140).gain(0.32)

arrange(
  [4, pad],
  [4, stack(pad, bass, arp.degradeBy(0.4))],
  [24, stack(pad, bass, arp, hat, pulse)],
  [4, stack(pad, arp.degradeBy(0.5))],
)
